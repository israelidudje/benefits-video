{
  "name": "petsy-benefits-video",
  "version": "1.0.0",
  "description": "Data-driven benefits explainer video built with Remotion",
  "repository": {},
  "license": "MIT",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render BenefitsSquare out/benefits-square.mp4 --codec=h264 --crf=18",
    "render:story": "remotion render BenefitsStory out/benefits-story.mp4 --codec=h264 --crf=18",
    "render:example": "remotion render BenefitsSquare out/example-props.mp4 --props=examples/three-benefits.json"
  },
  "allowScripts": {
    "esbuild": false
  }
}
